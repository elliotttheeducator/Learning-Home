{
  // Must match the Worker name in the Cloudflare dashboard, or Workers Builds fails.
  "name": "learning-home",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "preview_urls": true
}
